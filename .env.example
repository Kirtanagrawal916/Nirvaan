# ==========================================
# NIRVAAN BACKEND (Render Web Service)
# ==========================================
PORT=8000
CORS_ORIGINS=https://nirvaan-one.vercel.app,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
LIVE_ANALYSIS_TIMEOUT_SEC=10.0
JWT_SECRET_KEY=your-secure-random-jwt-secret-min-32-chars
GEMINI_API_KEY=
LOG_LEVEL=INFO

# ==========================================
# COPERNICUS DATA SPACE ECOSYSTEM (Sentinel-2)
# ==========================================
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1/
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# ==========================================
# NIRVAAN FRONTEND (Vercel Project Settings)
# ==========================================
# (Optional override: frontend defaults automatically to https://nirvaan-pd7i.onrender.com/api on Vercel)
VITE_API_BASE_URL=https://nirvaan-pd7i.onrender.com/api